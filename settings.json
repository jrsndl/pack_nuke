{
    "schema_version": 2,
    "_comment": "Pack Nuke settings. See README. Templates use {token} or nested {project[name]}; tokens come from the source place anatomy, script path tags, and job/script values.",
    "job": {
        "_comment": "Package folder = job_root/job_name. Uses the source place anatomy plus place_source, place_target and timestamp (UTC YYMMDD_HHMM_ + local offset).",
        "job_name_default": "{place_source}2{place_target}_{timestamp}",
        "job_name_check": "^(.+)2(.+)_(\\d{6}_\\d{4})_([-]?\\d{4})[_]?(?:.*)$",
        "job_root": "{root[work]}/{project[name]}/out/packNuke/{place_source}2{place_target}"
    },
    "nuke_scripts": {
        "source": {
            "_comment": "Copy of the original script, untouched.",
            "copy": true,
            "path": "{job}/{SHOT}/{script_name}_source.nk"
        },
        "package": {
            "_comment": "Script inside the package, relinked to the copied files (relative to the script folder, N levels above it, or a custom project folder).",
            "copy": true,
            "path": "{job}/{SHOT}/{script_name}_check.nk",
            "relative": true,
            "relative_custom_project": false,
            "relative_custom_project_template": "{job}",
            "relative_above_script": 1
        },
        "target": {
            "_comment": "Script relinked for the receiving place: saved at path, but its links point to the *_relink locations and relative paths are computed from path_relink (where it will live at the target).",
            "copy": false,
            "path": "{job}/{SHOT}/{script_name}_target.nk",
            "path_relink": "/vendor1_relink_root/{SHOT}/nuke/{script_name}_target.nk",
            "relative": true,
            "relative_custom_project": false,
            "relative_custom_project_template": "{job}",
            "relative_above_script": 2
        }
    },
    "hashes": {
        "_comment": "Hash every packed file while copying (blake2b) for later identification.",
        "hashes_generate": false
    },
    "copy": {
        "_comment": "Farm copy: files copied in parallel per job; identical files (same size and date) already in the package are skipped.",
        "threads": 8,
        "skip_identical": true
    },
    "packing": {
        "_comment": "category_match: all = copy into every matching category, first = first match only. Write-type nodes are outputs and are skipped unless include_write_nodes.",
        "category_match": "all",
        "fail_on_missing": false,
        "mark_nodes": true,
        "include_write_nodes": false
    },
    "places": {
        "bc": {
            "_comment": "Each place has anatomy tokens and optional tags parsed from the Nuke script path.",
            "anatomy": {
                "studio": {
                    "name": "BlindCat",
                    "code": "bc"
                },
                "project": {
                    "name": "BCV_054_HAR",
                    "code": "bcv054"
                },
                "root": {
                    "work": "z:"
                }
            },
            "use_script_path_tags": true,
            "script_path_tags": [
                {
                    "name": "SHOT",
                    "source": "File Name",
                    "search": "^([^_]*_[^_]*_[^_]*_[^_]*)_([^_]*)(.*)$",
                    "replace": "\\1",
                    "lowercase": false,
                    "uppercase": false
                },
                {
                    "name": "SEQ",
                    "source": "File Name",
                    "search": "^(sq\\d{2,4}).*$",
                    "replace": "\\1",
                    "lowercase": false,
                    "uppercase": false
                },
                {
                    "name": "TASK",
                    "source": "File Name",
                    "search": "^.*_([^_]+)_v\\d{2,4}.*$",
                    "replace": "\\1",
                    "lowercase": false,
                    "uppercase": false
                },
                {
                    "name": "VERSION",
                    "source": "File Name",
                    "search": "^.*_v(\\d{2,4}).*$",
                    "replace": "\\1",
                    "lowercase": false,
                    "uppercase": false
                },
                {
                    "name": "EP",
                    "source": "File Name",
                    "search": ".*",
                    "replace": "101",
                    "lowercase": false,
                    "uppercase": false
                }
            ]
        },
        "out": {
            "anatomy": {
                "studio": {
                    "name": "Vendor1",
                    "code": "vdr1"
                },
                "project": {
                    "name": "BCV_054_HAR",
                    "code": "bcv054"
                },
                "root": {
                    "work": "z:"
                }
            },
            "use_script_path_tags": true,
            "script_path_tags": [
                {
                    "name": "SHOT",
                    "source": "File Name",
                    "search": "^([^_]*_[^_]*_[^_]*_[^_]*)_([^_]*)(.*)$",
                    "replace": "\\1",
                    "lowercase": false,
                    "uppercase": false
                },
                {
                    "name": "SEQ",
                    "source": "File Name",
                    "search": "^(sq\\d{2,4}).*$",
                    "replace": "\\1",
                    "lowercase": true,
                    "uppercase": false
                },
                {
                    "name": "TASK",
                    "source": "File Name",
                    "search": "^.*_([^_]+)_v\\d{2,4}.*$",
                    "replace": "\\1",
                    "lowercase": true,
                    "uppercase": false
                },
                {
                    "name": "VERSION",
                    "source": "File Name",
                    "search": "^.*_v(\\d{2,4}).*$",
                    "replace": "\\1",
                    "lowercase": false,
                    "uppercase": false
                },
                {
                    "name": "EP",
                    "source": "File Name",
                    "search": ".*",
                    "replace": "101",
                    "lowercase": true,
                    "uppercase": false
                }
            ]
        }
    },
    "categories": {
        "src": {
            "path": {
                "_comment": "Root and top folder construct the package location of the file. The file name is not renamed, so care must be taken to make sure the path is unique.",
                "root_template": "{job}/{SHOT}/{category}",
                "root_template_relink": "{job}/{SHOT}/{category}",
                "top_folder": "{node}",
                "top_folder_relink": "{node}"
            },
            "filter_options": {
                "_comment": "Allows to skip nodes that are not connected to any other node (often old renders) and disabled nodes. Combine can be AND or OR",
                "skip_disconnected": true,
                "skip_disabled": true,
                "combine_filters": "OR"
            },
            "filters": [
                {
                    "_comment": "Source: File Name | File Path | Node Class | Knob Name. Regex group 1 is the value (whole match if no group). With a check list the filter hits only when the value is in the list (case-insensitive). invert flips the hit. token_name adds the value as a token.",
                    "source": "File Name",
                    "search": ".*\\.(\\w{2,4})$",
                    "check": [
                        "exr",
                        "jpg",
                        "jpeg",
                        "mov",
                        "mp4",
                        "png"
                    ],
                    "token_name": "extension",
                    "invert": false
                },
                {
                    "source": "File Path",
                    "search": ".*\\/(v\\d\\d\\d)\\/.*",
                    "check": [],
                    "token_name": "version_from_path",
                    "invert": false
                },
                {
                    "source": "Node Class",
                    "search": "Read DeepRead ReadGeo ReadGeo2 Camera Camera2 Camera3 Axis Axis2 Axis3 OCIOFileTransform Vectorfield",
                    "check": [],
                    "token_name": "class_read",
                    "invert": false
                }
            ]
        }
    },
    "fonts": {
        "_comment": "Font category",
        "enabled": true,
        "root_template": "{job}/_shared",
        "root_template_relink": "/vendor1_relink_root/_shared",
        "top_folder": "fonts",
        "top_folder_relink": "fonts",
        "skip_disconnected": true,
        "skip_disabled": true
    },
    "gizmos": {
        "_comment": "Gizmos category. Option to convert gizmos to groups still copies the gizmos.",
        "enabled": true,
        "to_groups": true,
        "root_template": "{job}/_shared",
        "root_template_relink": "/vendor1_relink_root/_shared",
        "top_folder": "gizmos",
        "top_folder_relink": "gizmos",
        "skip_disconnected": true,
        "skip_disabled": true
    },
    "ocio": {
        "_comment": "Copies the folder containing the custom OCIO config (or $OCIO). Refuses folders with more than max_files files.",
        "enabled": true,
        "root_template": "{job}/_shared/ocio",
        "root_template_relink": "/vendor1_relink_root/_shared/ocio",
        "top_folder": "",
        "top_folder_relink": "",
        "relative": true,
        "max_files": 5000
    },
    "nuke": {
        "_comment": "OS specific path to Nuke executable to be used for Deadline processing.",
        "Windows": "C:/Program Files/Nuke15.2v4/Nuke15.2.exe",
        "Linux": "C:/Program Files/Nuke15.2v4/Nuke15.2",
        "Darwin": "C:/Program Files/Nuke15.2v4/Nuke15.2"
    },
    "deadline": {
        "_comment": "OS specific path to Deadline command executable to be used for sending job to farm.",
        "Windows": "C:/Program Files/Thinkbox/Deadline10/bin/deadlinecommand.exe",
        "Linux": "C:/Program Files/Thinkbox/Deadline10/bin/deadlinecommand.exe",
        "Darwin": "C:/Program Files/Thinkbox/Deadline10/bin/deadlinecommand.exe"
    },
    "deadline_python": {
        "_comment": "Path to this repository's pack_nuke.py as seen by the farm machines.",
        "Windows": "c:/_GFX_library/pack_nuke/pack_nuke.py",
        "Linux": "c:/_GFX_library/pack_nuke/pack_nuke.py",
        "Darwin": "c:/_GFX_library/pack_nuke/pack_nuke.py"
    },
    "deadline_job": {
        "_comment": "Controls the machines that will accept the pack nuke tasks.",
        "pool": "all",
        "group": "packnuke",
        "priority": 40,
        "department": "io",
        "LimitGroups": "nuke",
        "comment": ""
    }
}
